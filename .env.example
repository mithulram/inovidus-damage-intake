# Anbieter für das "Lesen" der E-Mail. Leer lassen / offline = ohne API-Key (regelbasiert).
LLM_PROVIDER=offline        # offline | groq | recorded
GROQ_API_KEY=               # https://console.groq.com/keys (kostenloser Tarif)
GROQ_MODEL=                 # optional, Standard siehe docs/reference/groq_api.md
# Fachliche Regeln (Schwellen, Gewichte, Dringlichkeit) stehen NICHT hier, sondern in config/rules.yaml.
